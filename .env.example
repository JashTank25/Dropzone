# Optional Configurable Limits
VITE_MAX_FILE_SIZE_MB="250"

# Optional external Node.js backend URL if frontend is hosted separately (e.g., on Vercel)
# Leave empty when frontend and server.ts share the same origin
VITE_API_BASE_URL=""

# Optional comma-separated CORS origins on the Node.js server (e.g., https://dropzone-drab.vercel.app)
CORS_ORIGIN=""

# Optional WebRTC TURN Server Configuration (for Direct Transfer Mode across strict NATs)
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
